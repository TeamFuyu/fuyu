; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fuyu"
config/description="Fuyu est un jeu vidéo de la #FUYUTEAM racontant l'histoire d'un petit oiseau tombé d'une montagne."
config/version="0.2a"
run/main_scene="uid://ylijv6ppm0iq"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/use_filter=false
boot_splash/image="res://.theme/icons/godot/screen.png"
config/icon="uid://lbau6tqn834b"

[autoload]

global="*res://scripts/global/global.gd"
dial="*res://scripts/global/dial.gd"

[dialogic]

directories/dch_directory={
"fuyu": "res://dialogs/characters/fuyu.dch",
"vieux": "res://dialogs/characters/vieux.dch"
}
directories/dtl_directory={
"coucou": "res://dialogs/timeline/level1/coucou.dtl"
}
layout/style_list=[""]
layout/default_style=""

[display]

window/size/mode=2

[editor_plugins]

enabled=PackedStringArray()

